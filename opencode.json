{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      ".github/*": "deny",
      "opencode.json": "deny",
      "macros/guardia_destructiva.sql": "deny",
      "scripts/setup_github.sh": "deny",
      "Makefile": "ask",
      "*.duckdb": "deny"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "grep *": "allow",
      "make setup": "allow",
      "make ingest": "allow",
      "make build": "allow",
      "make run": "allow",
      "make counts": "allow",
      "dbt *": "allow",
      ".venv/bin/dbt *": "allow",
      "python scripts/*": "allow",
      ".venv/bin/python scripts/*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git switch -c *": "allow",
      "git checkout -b *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push -u origin feature/*": "allow",
      "git push -u origin fix/*": "allow",
      "gh pr create *": "allow",
      "gh pr view *": "allow",
      "gh pr checks *": "allow",
      "gh run *": "allow",
      "gh workflow run destructive.yml *": "allow",
      "*--full-refresh*": "deny",
      "*APROBACION_DESTRUCTIVA*": "deny",
      "make full-refresh*": "deny",
      "make reset-landing*": "deny",
      "*drop *": "deny",
      "*DROP *": "deny",
      "*truncate *": "deny",
      "*TRUNCATE *": "deny",
      "rm *": "deny",
      "*.duckdb*": "deny",
      "git push *main*": "deny",
      "git push *--force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "gh pr merge*": "deny",
      "gh api *": "deny",
      "gh secret *": "deny",
      "gh variable *": "deny"
    }
  }
}
